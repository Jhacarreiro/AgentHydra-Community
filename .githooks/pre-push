#!/bin/sh
# AgentHydra pre-push gate. Enabled by `git config core.hooksPath .githooks` (package.json's
# prepare does this).
#
# 1. Refuse a push to a PUBLIC remote unless AGENTHYDRA_PUSH_PUBLIC=1 is set for this command.
#    The heading is printed either way; the rule is announce-then-do.
# 2. Refuse a release tag (v*.*.*) while docs/todo/TODO.md has an open section. No override.
# 3. Refuse a release tag scripts/release-notes.mjs would refuse to publish. No override.
# 4. Refuse, on every remote, any ref whose history contains upstream's relicensing commit
#    aee9dfc4. No override.
# 5. Run scripts/audit-public.mjs --push over what the push carries, on every remote, private ones
#    too, and refuse on a finding or when the audit cannot give a verdict. No override.
# 6. Refuse a tag on upstream's work: on upstream's history up to 3a65ba8e (upstream's own tags), or
#    on a commit with 3a65ba8e's tree (the import commit at the root of this history). No override.
# 7. Refuse, on every remote, any ref whose history shares a commit with upstream's history up to
#    3a65ba8e, which this repository does not carry. A clone without 3a65ba8e passes. No override.
#
# Then a release tag in the push also needs CI to have passed on the exact commit the tag points
# to: `gh` is asked for a ci.yml run on that sha whose conclusion is success. When there is one,
# nothing more runs here, because every lane of `check:deep` (Biome, every typecheck, `bun test`,
# orchestrator/server's tests, the orchestrator Python suite) is a ci.yml step and already passed
# on that very commit. Re-running them here was a duplicate 25-minute gate on every release
# (measured on 1.7.0, 2026-10-02), after docs/RELEASING.md had already made "push main, wait for
# green CI" the step before tagging. When it cannot be confirmed (no gh, not signed in, offline, a
# remote that is not GitHub, no run on that sha, a run still going or not green), one line says
# why and the whole `check:deep` runs. A push with no release tag in it is done once rules 1 to 7
# pass.
#
# Rules 1 to 7 and their history live in .githooks/check-public-push.mjs. Git hands this hook the
# remote's name and URL as arguments and the refs on stdin; both are passed straight through.
#
# FAIL CLOSED. The Biome pre-commit guard steps aside when its runtime is missing, because a commit
# is local and cheap to redo. A push is neither, so with no node and no bun on PATH this refuses
# rather than guessing, and says how to proceed; and a release tag that needs `check:deep` with no
# bun on PATH to run it is refused, not waved through.
remote="$1"
url="$2"
# stdin can only be read once, and the CI check needs the refs as well as the guard.
refs=$(cat)

if command -v node >/dev/null 2>&1; then
  runner=node
elif command -v bun >/dev/null 2>&1; then
  runner=bun
else
  echo "" >&2
  echo "# WARNING: THIS REPOSITORY IS **PUBLIC**" >&2
  echo "" >&2
  echo "  pre-push: neither node nor bun is on PATH, so the public-push guard cannot look up" >&2
  echo "  whether $remote ($url) is public. Treated as public and refused." >&2
  if [ "$AGENTHYDRA_PUSH_PUBLIC" = "1" ]; then
    echo "  AGENTHYDRA_PUSH_PUBLIC=1 is set for this command: announced, proceeding." >&2
    exit 0
  fi
  echo "  Install node, or if the owner has decided this push goes out: AGENTHYDRA_PUSH_PUBLIC=1 git push ..." >&2
  exit 1
fi

printf '%s\n' "$refs" | "$runner" .githooks/check-public-push.mjs "$remote" "$url" || exit 1

# The same release-tag shape check-public-push.mjs gates on; a deleted tag (all-zero sha) is not a
# release. An annotated tag's sha is the tag object, so it is peeled to the commit CI ran on. This
# runs before the unset below, while git still points at the pushing checkout.
release_commits=""
unpeeled=""
for sha in $(printf '%s\n' "$refs" | awk '$2 !~ /^0+$/ && $3 ~ /^refs\/tags\/v[0-9]+\.[0-9]+\.[0-9]+/ { print $2 }'); do
  commit=$(git rev-parse --verify --quiet "$sha^{commit}") || commit=""
  if [ -n "$commit" ]; then
    release_commits="$release_commits $commit"
  else
    unpeeled="$sha"
  fi
done

if [ -z "$release_commits" ] && [ -z "$unpeeled" ]; then
  exit 0
fi

# Git runs this hook with GIT_DIR exported (and, from a linked worktree, GIT_WORK_TREE and
# GIT_INDEX_FILE too). `check:deep` is not a git command on this repo: its tests build throwaway
# repos, and every one inherited these and aimed git at this checkout instead. Pushing the 1.5.0
# tag from a worktree (2026-10-01) failed 29 git-backed tests that way. `check:deep` finds this
# repo from the working directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE

# A release tag: has ci.yml passed on the commit it points to? `why` stays empty only when every
# tagged commit has a ci.yml run whose conclusion is success.
slug=$(printf '%s\n' "$url" | sed -n -e 's#/*$##' -e 's#\.git$##' -e 's#^.*github\.com[:/]\([^/][^/]*/[^/][^/]*\)$#\1#p')
why=""
if [ -n "$unpeeled" ]; then
  why="the tag's sha $unpeeled does not resolve to a commit"
elif ! command -v gh >/dev/null 2>&1; then
  why="gh is not on PATH"
elif [ -z "$slug" ]; then
  why="$url is not a GitHub remote"
else
  for commit in $release_commits; do
    answer=$(gh run list -R "$slug" --workflow ci.yml --commit "$commit" --limit 20 \
      --json status,conclusion,url \
      --jq 'if any(.[]; .conclusion == "success") then "success " + ([.[] | select(.conclusion == "success")][0].url) elif length == 0 then "none" else .[0].status + "/" + (.[0].conclusion // "") end' \
      2>&1) || {
      why="gh could not read ci.yml's runs (not signed in or offline?): $(printf '%s\n' "$answer" | head -n 1)"
      break
    }
    case "$answer" in
      success\ *) echo "pre-push: ci.yml passed on the tagged commit $commit: ${answer#success }" >&2 ;;
      none)
        why="ci.yml has no run on the tagged commit $commit"
        break
        ;;
      *)
        why="ci.yml has not passed on the tagged commit $commit (newest run: $answer)"
        break
        ;;
    esac
  done
fi

if [ -z "$why" ]; then
  exit 0
fi
echo "pre-push: CI not confirmed, so the full check:deep runs (25+ minutes): $why." >&2
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is not on PATH, so check:deep cannot run. Refused; install bun, or push the tag once CI has passed on its commit." >&2
  exit 1
fi
bun run check:deep || exit 1
